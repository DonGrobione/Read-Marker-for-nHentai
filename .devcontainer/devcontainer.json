{
  "name": "Read Marker for nHentai",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    // Lightweight desktop for running Firefox; view it at http://localhost:6080 (password: vscode)
    "ghcr.io/devcontainers/features/desktop-lite:1": {}
  },
  // Firefox needs more shared memory than Docker's 64 MB default
  "runArgs": ["--shm-size=1g"],
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Desktop (noVNC)",
      "onAutoForward": "notify"
    }
  },
  // node_modules lives in a Docker volume, not in the bind-mounted (cloud-synced) repo folder:
  // npm's .bin entries are Linux symlinks that Windows sync clients cannot handle.
  "mounts": [
    "source=read-marker-node_modules,target=${containerWorkspaceFolder}/node_modules,type=volume"
  ],
  // A new volume is owned by root, so hand it to the node user before installing.
  "postCreateCommand": "sudo chown node:node node_modules && npm ci",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "ms-python.python"
      ]
    }
  },
  "remoteUser": "node"
}
