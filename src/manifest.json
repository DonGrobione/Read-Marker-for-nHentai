{
  "manifest_version": 3,
  "name": "nHentai Gallery Remember",
  "version": "1.0.0",
  "description": "Remembers which nhentai.net galleries you opened and marks their thumbnails with a green frame.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://nhentai.net/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "nhentai-gallery-remember@extension",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
